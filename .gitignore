.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment secrets
assets/env/.env
*.env
!assets/env/.env.example
.tmp-deploy-args-only.json

# Signing keys, certificates, and Apple/Google service accounts
**/*.p8
**/*.p12
**/*.pem
**/*.mobileprovision
**/*.jks
**/*.keystore
**/key.properties
**/*-adminsdk*.json
**/serviceAccount*.json
**/AuthKey_*.p8

# Local Apple Sign In helper (contains Team ID, Key ID, and .p8)
/utils_project/

# Node / Cloudflare Wrangler local state
# package.json is only for the local Apple JWT helper in utils_project/
/package.json
/package-lock.json
node_modules/
.wrangler/

# Editor / OS
.cursor/
.idea/
*.iml

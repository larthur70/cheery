# Copy this file to assets/env/.env and fill in your own values.
# Never commit assets/env/.env
#
# Dashboard → Project Settings → API
#
# AUTH_OAUTH_REDIRECT ............. fallback Web (at runtime uses Uri.base)
# AUTH_PASSWORD_RESET_REDIRECT .... fallback Web (at runtime uses Uri.base)
# Mobile always uses cheery://auth-callback
#
# In Supabase → Authentication → URL Configuration → Redirect URLs:
#   cheery://auth-callback
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/reset-password
#   https://YOUR_APP_HOST/auth/callback
#   https://YOUR_APP_HOST/auth/reset-password
#
# Apple (Dashboard → Authentication → Providers → Apple):
#   Client ID ....... Services ID (not the iOS bundle ID)
#   Secret Key ...... JWT generated with Key ID + Team ID + .p8
#
# Push / birthday reminders (Edge Function secrets — NOT in the client app):
#   Dashboard → Edge Functions → Secrets
#   CRON_SECRET .................. same value used by cron/vault
#   FCM_SERVICE_ACCOUNT_JSON ..... Firebase service account JSON (FCM)
#   FIREBASE_PROJECT_ID .......... optional if already in the JSON
#
# Account deletion confirmation email (Edge Function secrets):
#   RESEND_API_KEY ............... Resend API key
#   EMAIL_FROM ................... optional
#   APP_ORIGIN ................... optional, e.g. https://YOUR_APP_HOST
# Redirect URL also in Supabase Auth:
#   https://YOUR_APP_HOST/auth/confirm-delete

SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
AUTH_OAUTH_REDIRECT=https://YOUR_APP_HOST/auth/callback
AUTH_PASSWORD_RESET_REDIRECT=https://YOUR_APP_HOST/auth/reset-password

# PostHog (Dashboard → Project Settings → Project API Key)
# Host: https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU)
# Web also needs the same project token in web/index.html (posthog.init).
# Mobile/desktop use these env vars via PosthogInitializer.
POSTHOG_API_KEY=YOUR_POSTHOG_API_KEY
POSTHOG_HOST=https://us.i.posthog.com
